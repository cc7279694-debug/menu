+/* Accepted G1 layout shared by showcase and production core screens. */
+.recipio-ui-v2 .v2-home { width: 100%; max-width: 680px; padding: 0 20px calc(var(--v2-controls-height,0px) + 28px); margin-inline: auto; scroll-padding-bottom: calc(var(--v2-controls-height,0px) + 24px); }
+.recipio-ui-v2 .v2-home-controls.v2-glass { position: sticky; top: 0; z-index: 1; margin-inline: -20px; padding: 12px 20px; border-bottom: 1px solid var(--v2-glass-low-edge); border-radius: 0; box-shadow: inset 0 -1px 0 var(--v2-glass-edge); }
+.recipio-ui-v2 .v2-home-header { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 48px; margin-bottom: 12px; }
+.recipio-ui-v2 .v2-home-header > .v2-button { border: 1px solid var(--v2-border); flex: 0 0 48px; }
+.recipio-ui-v2 .v2-brand { display: flex; align-items: center; gap: 12px; }
+.recipio-ui-v2 .v2-brand img { width: 36px; height: 36px; flex-shrink: 0; border-radius: 9px; }
+.recipio-ui-v2 .v2-brand h1 { font-size: 1.375rem; font-weight: 600; line-height: 1.33; letter-spacing: .05em; }
+.recipio-ui-v2 .v2-brand span { display: block; font-size: .625rem; letter-spacing: .28em; line-height: 1.6; }
+.recipio-ui-v2 .v2-page-title { font-size: 1.75rem; font-weight: 600; line-height: 1.28; overflow-wrap: anywhere; }
+.recipio-ui-v2 .v2-search { display: flex; align-items: center; min-height: 52px; padding: 0 12px 0 16px; gap: 10px; background: var(--v2-field-shield); border: 1px solid var(--v2-control); border-radius: 18px; box-shadow: inset 0 1px 0 var(--v2-glass-edge); }
+.recipio-ui-v2 .v2-search > svg { flex: 0 0 20px; height: 20px; color: var(--v2-caption); stroke-width: 1.6; }
+.recipio-ui-v2 .v2-search input { width: 100%; min-width: 0; min-height: 50px; border: 0; padding: 8px 0; background: transparent; outline-offset: 3px; font-size: 1rem; }
+.recipio-ui-v2 .v2-search input::placeholder { color: var(--v2-caption); }
+.recipio-ui-v2 .v2-search input::-webkit-search-cancel-button { display: none; }
+.recipio-ui-v2 .v2-search .v2-button { flex: 0 0 48px; margin-right: -10px; background: transparent; }
+.recipio-ui-v2 .v2-entry-grid { display: grid; grid-template-columns: 1.15fr 1fr; gap: 8px; margin-top: 16px; }
+.recipio-ui-v2 .v2-entry-card { display: grid; grid-template-columns: 24px minmax(0,1fr); align-items: center; min-width: 0; min-height: 64px; gap: 10px; padding: 12px 10px; background: transparent; border: 1px solid transparent; border-radius: 18px; text-align: left; cursor: pointer; transition: background 120ms var(--v2-ease); }
+.recipio-ui-v2 .v2-entry-card--primary { background: var(--v2-soft); }
+.recipio-ui-v2 .v2-entry-card:active { background: var(--v2-muted); }
+.recipio-ui-v2 .v2-entry-symbol { width: 24px; height: 24px; display: grid; place-items: center; color: var(--v2-action); }
+.recipio-ui-v2 .v2-entry-symbol svg { width: 22px; height: 22px; stroke-width: 1.6; }
+.recipio-ui-v2 .v2-entry-copy { display: flex; flex-direction: column; gap: 4px; color: var(--v2-secondary); font-size: .75rem; line-height: 1.5; }
+.recipio-ui-v2 .v2-entry-card strong { color: var(--v2-text); font-size: 1rem; line-height: 1.5; font-weight: 600; overflow-wrap: anywhere; }
+.recipio-ui-v2 .v2-section { margin-top: 24px; }
+.recipio-ui-v2 .v2-section-heading { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 12px; }
+.recipio-ui-v2 .v2-section-heading h2, .recipio-ui-v2 .v2-content-section > h2 { font-size: 1.25rem; line-height: 1.4; font-weight: 600; }
+.recipio-ui-v2 .v2-section-heading .v2-button { font-size: .875rem; font-weight: 400; color: var(--v2-secondary); padding-inline: 0; flex-shrink: 0; }
+.recipio-ui-v2 .v2-section-heading .v2-button svg { width: 16px; height: 16px; }
+.recipio-ui-v2 .v2-recent-strip { display: flex; gap: 12px; overflow-x: auto; scroll-snap-type: x proximity; padding-bottom: 8px; scrollbar-width: none; }
+.recipio-ui-v2 .v2-recent-card { flex: 0 0 152px; min-width: 0; padding: 0; display: flex; flex-direction: column; gap: 4px; background: transparent; border: 0; text-align: left; cursor: pointer; scroll-snap-align: start; }
+.recipio-ui-v2 .v2-recent-card > img, .recipio-ui-v2 .v2-recent-card > .v2-image-placeholder { width: 100%; height: 114px; border-radius: 18px; object-fit: cover; font-size: .75rem; flex-wrap: wrap; }
+.recipio-ui-v2 .v2-recent-title { font-size: 1rem; line-height: 1.5; font-weight: 500; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; overflow-wrap: anywhere; }
+.recipio-ui-v2 .v2-recent-card > .v2-secondary { font-size: .75rem; line-height: 1.5; }
+.recipio-ui-v2 .v2-recipe-list { display: flex; flex-direction: column; }
+.recipio-ui-v2 .v2-recipe-row { display: grid; grid-template-columns: 72px minmax(0,1fr) 18px; align-items: center; gap: 12px; width: 100%; min-height: 96px; padding: 12px 0; border: 0; border-bottom: 1px solid var(--v2-border); background: transparent; text-align: left; cursor: pointer; }
+.recipio-ui-v2 .v2-recipe-row:active { background: var(--v2-muted); }
+.recipio-ui-v2 .v2-recipe-row > img, .recipio-ui-v2 .v2-recipe-row > .v2-image-placeholder { width: 72px; height: 72px; object-fit: cover; border-radius: 14px; font-size: .625rem; flex-direction: column; gap: 4px; }
+.recipio-ui-v2 .v2-row-text { min-width: 0; display: flex; flex-direction: column; gap: 5px; }
+.recipio-ui-v2 .v2-row-text strong { font-size: 1rem; font-weight: 500; line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; overflow-wrap: anywhere; }
+.recipio-ui-v2 .v2-recipe-row > svg { width: 18px; height: 18px; color: var(--v2-caption); }
+.recipio-ui-v2 .v2-filters { display: flex; gap: 8px; margin-top: 16px; padding: 3px 0; overflow-x: auto; scrollbar-width: none; }
